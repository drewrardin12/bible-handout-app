{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "@cloudflare/workers-types", "vinext/types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["pages/**/*.tsx", "app/page.tsx", "app/firebase*.ts", "app/use-firebase-records.ts", "app/message-templates.tsx", "app/dashboard-data.ts", "app/contact-filters.ts", "app/report-periods.ts", "vite.pages.config.ts"],
  "exclude": ["node_modules"]
}
