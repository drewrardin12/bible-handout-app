rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Membership is managed in the Firebase console, never by public app code.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function member(ministryId) {
      let membership = /databases/$(database)/documents/members/$(request.auth.uid);
      let invitation = /databases/$(database)/documents/accessInvites/$(request.auth.token.email);
      return verified() && (
        (exists(membership) && get(membership).data.get('ministryId','abm') == ministryId)
        || (!exists(membership) && exists(invitation) && get(invitation).data.ministryId == ministryId));
    }
    match /members/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /accessInvites/{email} {
      allow get: if verified() && request.auth.token.email == email;
      allow list, write: if false;
    }
    match /ministries/{ministryId}/settings/templates {
      allow read: if verified() && member(ministryId);
      allow create, update: if verified() && member(ministryId)
        && request.resource.data.keys().hasOnly(['items','revision','updatedBy','updatedAt'])
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 20
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Entry devices can submit immutable cards, but cannot read ministry data.
    match /ministries/{ministryId}/entryInbox/{id} {
      function validCard() {
        let c = request.resource.data.card;
        return c is map && c.size() <= 30
          && c.name is string && c.name.size() > 0 && c.name.size() <= 200
          && c.phone is string && c.phone.size() > 0 && c.phone.size() <= 100
          && c.metDate is string && c.metDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && c.notes is string && c.notes.size() <= 10000
          && c.rating is int && c.rating >= 0 && c.rating <= 3;
      }
      allow create: if ministryId == 'abm'
        && (request.resource.data.keys().hasOnly(['card'])
          || (request.resource.data.keys().hasOnly(['card','parentId','version'])
            && request.resource.data.parentId is string
            && request.resource.data.parentId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
            && exists(/databases/$(database)/documents/ministries/$(ministryId)/entryInbox/$(request.resource.data.parentId))
            && request.resource.data.version is int && request.resource.data.version > 0)) && validCard();
      allow read: if verified() && member(ministryId);
      // Exact retry is safe; public clients cannot change a submitted card.
      allow update: if request.resource.data == resource.data
        || (verified() && member(ministryId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['processed'])
          && request.resource.data.processed == true);
      allow delete: if false;
    }
    match /ministries/{ministryId}/records/{id} {
      allow read: if verified() && member(ministryId);
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind','data','revision','updatedBy','updatedAt'])
          && d.kind in ['contact','outing']
          && d.data is map
          && d.data.name is string && d.data.name.size() > 0
          && d.revision is int
          && (d.kind != 'outing' || (
            d.data.bibles is int && d.data.bibles >= 0
            && d.data.contactCards is int && d.data.contactCards >= 0
            && d.data.gospels is int && d.data.gospels >= 0
            && d.data.salvations is int && d.data.salvations >= 0
            && d.data.promises is int && d.data.promises >= 0))
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
      }
      allow create: if verified() && member(ministryId) && valid() && request.resource.data.revision == 1;
      allow update: if verified() && member(ministryId) && valid()
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
